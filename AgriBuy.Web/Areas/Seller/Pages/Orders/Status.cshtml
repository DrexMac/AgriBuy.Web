@page
@model AgriBuy.Web.Areas.Seller.Pages.Orders.StatusModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Order Status";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: url('/images/loginbg.jpg') no-repeat center center fixed;
        background-size: cover;
        padding: 40px 0;
        display: flex;
        justify-content: center;
    }

    .orders-card {
        width: 95%;
        max-width: 1100px;
        background-color: rgba(244, 248, 237, 0.95);
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    h1 {
        text-align: center;
        color: #2e7d32;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .table-container {
        max-height: 500px;
        overflow-y: auto;
        border: 1px solid #c8e6c9;
        border-radius: 8px;
        background-color: #fff;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 12px 10px;
        text-align: left;
        font-size: 14px;
        vertical-align: top;
    }

    th {
        background-color: #a5d6a7;
        color: #1b5e20;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .paid {
        color: #2e7d32;
        font-weight: bold;
    }

    .no-orders {
        text-align: center;
        padding: 20px;
        color: #666;
    }

    .status-form {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .status-form select {
        padding: 5px;
        border-radius: 4px;
        border: 1px solid #a5d6a7;
        font-size: 13px;
    }

    .status-form button {
        background-color: #2e7d32;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

    .status-form button:hover {
        background-color: #27632a;
    }

    .shipping-cell {
        font-size: 12px;
        line-height: 1.5;
    }
</style>

<div class="orders-card">
    <h1>🧾 Order Status</h1>

    @if (!Model.Orders.Any())
    {
        <div class="no-orders">No orders found for this store.</div>
    }
    else
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Buyer</th>
                        <th>Products</th>
                        <th>Total Price</th>
                        <th>Shipping To</th>
                        <th>Pay Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@($"{order.User?.FirstName} {order.User?.LastName}")</td>
                            <td>
                                @foreach (var item in order.OrderItems)
                                {
                                    <div>@item.Product?.Name × @item.Quantity</div>
                                }
                            </td>
                            <td>₱ @order.TotalPrice.ToString("N2")</td>
                            <td class="shipping-cell">
                                <strong>@order.ShippingFullName</strong><br />
                                @order.ShippingPhoneNumber<br />
                                @order.ShippingAddress, @order.ShippingCityProvince @order.ShippingPostalCode
                            </td>
                            <td>@order.PayDate?.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                <form method="post" asp-page-handler="UpdateStatus" class="status-form">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <input type="hidden" name="storeid" value="@Model.StoreId" />
                                    <select name="newStatus">
                                        @foreach (var s in Model.AllStatuses)
                                        {
                                            if (s == order.Status)
                                            {
                                                <option value="@s" selected>@s</option>
                                            }
                                            else
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-area="Seller" asp-page="/Stores/Details" asp-route-storeid="@Model.StoreId" class="back-link" style="color:#2e7d32;font-weight:600;">← Back to Store</a>
</div>