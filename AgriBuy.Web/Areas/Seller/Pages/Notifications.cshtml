@page
@model AgriBuy.Web.Areas.Seller.Pages.NotificationsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Notifications";
}
<div style="max-width:900px;margin:35px auto;padding:24px;background:#f4f8ed;border-radius:12px;">
    <h1 style="color:#2e7d32;">Order Notifications</h1>
    <p>Order, payment, and delivery updates for your store.</p>
    @if (!Model.Notifications.Any())
    {
        <p>No notifications yet.</p>
    }
    else
    {
        @foreach (var item in Model.Notifications)
        {
            <div style="margin:10px 0;padding:14px;border-radius:8px;background:@(item.IsRead ? "#ffffff" : "#e8f5e9");border:1px solid #c8e6c9;">
                <div>@item.Message</div>
                <small>@item.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</small>
                @if (!item.IsRead)
                {
                    <form method="post" asp-page-handler="MarkRead" style="display:inline;margin-left:12px;">
                        <input type="hidden" name="notificationId" value="@item.Id" />
                        <button type="submit">Mark as read</button>
                    </form>
                }
            </div>
        }
    }
    <a asp-area="Seller" asp-page="/Stores/Index" style="display:inline-block;margin-top:16px;color:#2e7d32;">Back to My Store</a>
</div>