@page
@model AgriBuy.Web.Areas.Buyer.Pages.Cart.OrderDetailsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "My Orders";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: url('/images/loginbg.jpg') no-repeat center center fixed;
        background-size: cover;
        padding: 40px 0;
        display: flex;
        justify-content: center;
    }

    .orders-card {
        width: 95%;
        max-width: 900px;
        background-color: rgba(244, 248, 237, 0.95);
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    h1 {
        text-align: center;
        color: #2e7d32;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .order-box {
        background: #fff;
        border: 1px solid #c8e6c9;
        border-radius: 10px;
        padding: 18px 20px;
    }

    .order-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .order-number {
        font-weight: 700;
        color: #33691e;
        font-size: 16px;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 700;
        background-color: #c8e6c9;
        color: #1b5e20;
    }

    .status-Cancelled {
        background-color: #ffcdd2;
        color: #b71c1c;
    }

    .status-Delivered {
        background-color: #a5d6a7;
        color: #1b5e20;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 8px 10px;
        text-align: left;
        font-size: 14px;
    }

    th {
        background-color: #a5d6a7;
        color: #1b5e20;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 20px;
        margin-top: 10px;
        font-size: 14px;
        color: #444;
    }

    .info-grid strong {
        color: #33691e;
    }

    .no-orders {
        text-align: center;
        padding: 20px;
        color: #666;
        font-weight: 500;
    }

    .back-link {
        background-color: #2e7d32;
        color: white;
        font-weight: 600;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        align-self: flex-start;
        transition: background-color 0.2s;
    }

    .back-link:hover {
        background-color: #27632a;
    }
</style>

<div class="orders-card">
    <a asp-page="/ShoppingCart" class="back-link">← Back to Cart</a>
    <h1>🧾 My Orders</h1>

    @if (!Model.Orders.Any())
    {
        <div class="no-orders">You haven't placed any orders yet.</div>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            <div class="order-box">
                <div class="order-box-header">
                    <div class="order-number">Order #@order.OrderNumber</div>
                    <span class="status-badge status-@order.Status">@order.Status</span>
                </div>

                <div class="info-grid">
                    <div><strong>Order Date:</strong> @order.OrderDate.ToString("MMM dd, yyyy")</div>
                    <div><strong>Pay Date:</strong> @order.PayDate?.ToString("MMM dd, yyyy hh:mm tt")</div>
                    <div><strong>Estimated Delivery:</strong> @order.EstimatedDeliveryDate?.ToString("MMM dd, yyyy")</div>
                    <div><strong>Total:</strong> ₱ @order.TotalPrice.ToString("N2")</div>
                </div>

                <div class="info-grid">
                    <div>
                        <strong>Ship To:</strong> @order.ShippingFullName<br />
                        @order.ShippingPhoneNumber<br />
                        @order.ShippingAddress, @order.ShippingCityProvince @order.ShippingPostalCode
                    </div>
                </div>

                <table>
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.OrderItems)
                        {
                            <tr>
                                <td>@item.Product?.Name</td>
                                <td>@item.Quantity</td>
                                <td>₱ @item.UnitPrice.ToString("N2")</td>
                                <td>₱ @((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>