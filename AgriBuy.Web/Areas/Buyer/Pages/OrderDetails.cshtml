@page
@model AgriBuy.Web.Areas.Buyer.Pages.Cart.OrderDetailsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using AgriBuy.Models.Enums

@{
    ViewData["Title"] = "My Orders";
}

<style>

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: url('/images/loginbg.jpg') no-repeat center center fixed;
        background-size: cover;
        padding: 40px 0;
        display: flex;
        justify-content: center;
    }

    .orders-card {
        width: 95%;
        max-width: 1000px;
        background-color: rgba(244, 248, 237, 0.95);
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    h1 {
        text-align: center;
        color: #2e7d32;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .order-box {
        background: #fff;
        border: 1px solid #c8e6c9;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .order-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 15px;
    }

    .order-number {
        font-weight: 700;
        color: #33691e;
        font-size: 17px;
    }

    /* ============================
           STATUS BADGES
           ============================ */

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-Pending {
        background-color: #fff3cd;
        color: #7a5b00;
    }

    .status-Processing {
        background-color: #cfe2ff;
        color: #084298;
    }

    .status-Shipped {
        background-color: #e2d9f3;
        color: #4b2e83;
    }

    .status-Delivered {
        background-color: #a5d6a7;
        color: #1b5e20;
    }

    .status-Cancelled {
        background-color: #ffcdd2;
        color: #b71c1c;
    }

    /* ============================
           STATUS MESSAGE
           ============================ */

    .status-message {
        margin: 15px 0;
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    .message-Pending {
        background-color: #fff8e1;
        color: #7a5b00;
        border-left: 4px solid #ffc107;
    }

    .message-Processing {
        background-color: #e3f2fd;
        color: #084298;
        border-left: 4px solid #2196f3;
    }

    .message-Shipped {
        background-color: #f3e5f5;
        color: #4b2e83;
        border-left: 4px solid #7b1fa2;
    }

    .message-Delivered {
        background-color: #e8f5e9;
        color: #1b5e20;
        border-left: 4px solid #2e7d32;
    }

    .message-Cancelled {
        background-color: #ffebee;
        color: #b71c1c;
        border-left: 4px solid #d32f2f;
    }

    /* ============================
           ORDER INFO
           ============================ */

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 25px;
        margin-top: 10px;
        font-size: 14px;
        color: #444;
    }

        .info-grid strong {
            color: #33691e;
        }

    /* ============================
           PRODUCTS TABLE
           ============================ */

    .table-container {
        width: 100%;
        overflow-x: auto;
        margin-top: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

    th,
    td {
        border: 1px solid #ddd;
        padding: 9px 10px;
        text-align: left;
        font-size: 14px;
    }

    th {
        background-color: #a5d6a7;
        color: #1b5e20;
        font-weight: 700;
    }

    tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    /* ============================
           NO ORDERS
           ============================ */

    .no-orders {
        text-align: center;
        padding: 30px 20px;
        color: #666;
        font-weight: 500;
        background: white;
        border-radius: 10px;
    }

    /* ============================
           BACK BUTTON
           ============================ */

    .back-link {
        background-color: #2e7d32;
        color: white;
        font-weight: 600;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        text-decoration: none;
        align-self: flex-start;
        transition: background-color 0.2s;
    }

        .back-link:hover {
            background-color: #27632a;
            color: white;
        }

    /* ============================
           RESPONSIVE
           ============================ */

    @@media (max-width: 700px) {
        body

    {
        padding: 20px 0;
    }

    .orders-card {
        width: 92%;
        padding: 20px;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .order-box-header {
        flex-direction: column;
        align-items: flex-start;
    }

    }
</style>


<div class="orders-card">

    <a asp-page="/ShoppingCart" class="back-link">
        ← Back to Cart
    </a>

    <h1>🧾 My Orders</h1>

    <a asp-page="/Notifications" style="align-self:flex-end;color:#2e7d32;font-weight:600;">View order notifications</a>


    @if (!Model.Orders.Any())
    {
        <div class="no-orders">
            You haven't placed any orders yet.
        </div>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            <div class="order-box">

                <!-- ============================
                     ORDER HEADER
                     ============================ -->

                <div class="order-box-header">

                    <div class="order-number">
                        Order #@order.OrderNumber
                    </div>

                    <span class="status-badge status-@order.Status">
                        @order.Status
                    </span>

                </div>


                <!-- ============================
                     STATUS MESSAGE
                     ============================ -->
                @if (order.Status == OrderStatus.Pending)
                {
                    <div class="status-message message-Pending">
                        ⏳ Your order is pending and is waiting to be processed by the seller.
                    </div>
                }
                else if (order.Status == OrderStatus.Processing)
                {
                    <div class="status-message message-Processing">
                        🔄 Your order is currently being processed by the seller.
                    </div>
                }
                else if (order.Status == OrderStatus.Shipped)
                {
                    <div class="status-message message-Shipped">
                        🚚 Your order has been shipped and is on its way to you.
                    </div>
                }
                else if (order.Status == OrderStatus.Delivered)
                {
                    <div class="status-message message-Delivered">
                        ✅ Your order has been delivered.
                    </div>
                }
                else if (order.Status == OrderStatus.Cancelled)
                {
                    <div class="status-message message-Cancelled">
                        ❌ This order has been cancelled.
                    </div>
                }


                @if (order.OrderDeliveryProof != null)
                {
                    <div style="margin:15px 0;padding:12px;background:#f1f8e9;border:1px solid #c8e6c9;border-radius:8px;">
                        <strong style="color:#2e7d32;">Seller delivery proof</strong><br />
                        <a href="@order.OrderDeliveryProof.ImagePath" target="_blank" rel="noopener">
                            <img src="@order.OrderDeliveryProof.ImagePath" alt="Delivery proof for order @order.OrderNumber"
                                 style="display:block;max-width:320px;max-height:260px;object-fit:contain;margin-top:8px;border-radius:6px;" />
                        </a>
                        <small>Uploaded @order.OrderDeliveryProof.UploadedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</small>
                    </div>
                }

                <!-- ============================
                     ORDER INFORMATION
                     ============================ -->

                <div class="info-grid">

                    <div>
                        <strong>Order Date:</strong>
                        @order.OrderDate.ToString("MMM dd, yyyy")
                    </div>

                    <div>
                        <strong>Pay Date:</strong>

                        @if (order.PayDate.HasValue)
                        {
                            @order.PayDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </div>

                    <div>
                        <strong>Total:</strong>
                        ₱ @order.TotalPrice.ToString("N2")
                    </div>

                    <div>
                        <strong>OR Number:</strong>

                        @if (!string.IsNullOrEmpty(order.ORNumber))
                        {
                            @order.ORNumber
                        }
                        else
                        {
                            <span>N/A</span>
                        }
                    </div>

                    @if (order.FulfillmentDate.HasValue)
                    {
                        <div>
                            <strong>Fulfillment Date:</strong>
                            @order.FulfillmentDate.Value.ToString("MMM dd, yyyy hh:mm tt")
                        </div>
                    }

                </div>


                <!-- ============================
                     PRODUCTS
                     ============================ -->

                <div class="table-container">

                    <table>

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in order.OrderItems)
                            {
                                <tr>

                                    <td>
                                        @item.Product?.Name
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        ₱ @item.UnitPrice.ToString("N2")
                                    </td>

                                    <td>
                                        ₱ @((item.Quantity * item.UnitPrice).ToString("N2"))
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }

</div>
