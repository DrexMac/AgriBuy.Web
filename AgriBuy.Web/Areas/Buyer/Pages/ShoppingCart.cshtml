@page
@model AgriBuy.Web.Areas.Buyer.Pages.ShoppingCartModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Shopping Cart";
}

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: url('/images/loginbg.jpg') no-repeat center center fixed;
        background-size: cover;
        display: flex;
        justify-content: center;
        padding: 30px 0;
        box-sizing: border-box;
    }

    /* =========================================
           MAIN CART CARD
           ========================================= */

    .cart-card {
        width: 95%;
        max-width: 1100px;
        height: 92vh;
        max-height: 900px;
        background-color: rgba(244, 248, 237, 0.95);
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        backdrop-filter: blur(5px);
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        overflow: hidden;
    }

    /* =========================================
           HEADER
           ========================================= */

    .cart-header {
        flex-shrink: 0;
        font-weight: 700;
        font-size: 24px;
        color: #7a9a2f;
        text-align: center;
        margin: 0 0 12px 0;
    }

    /* =========================================
           BACK BUTTON
           ========================================= */

    a.back-link {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        background-color: #2e7d32;
        color: white;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        margin-bottom: 12px;
        transition: background-color 0.2s;
        flex-shrink: 0;
    }

        a.back-link:hover {
            background-color: #27632a;
        }

    /* =========================================
           CART WINDOW
           ========================================= */

    .cart-window {
        /*
             * This is the main shopping cart area.
             * It takes all remaining available space.
             */
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        border: 1px solid #c8e6c9;
        border-radius: 8px;
        background-color: rgba(255, 255, 255, 0.75);
        padding: 10px;
        overflow: hidden;
    }

    /* =========================================
           CART TABLE CONTAINER
           ========================================= */

    .cart-table-container {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: auto;
        border-radius: 6px;
        background-color: white;
    }

        .cart-table-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .cart-table-container::-webkit-scrollbar-thumb {
            background: #a5d6a7;
            border-radius: 4px;
        }

            .cart-table-container::-webkit-scrollbar-thumb:hover {
                background: #81c784;
            }

    /* =========================================
           CART TABLE
           ========================================= */

    .cart-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
    }

        .cart-table th,
        .cart-table td {
            border: 1px solid #ddd;
            padding: 9px 8px;
            text-align: left;
            font-size: 14px;
        }

        .cart-table th {
            background-color: #a5d6a7;
            color: #1b5e20;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .cart-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .cart-table tr:hover {
            background-color: #f1f8f1;
        }

    /* =========================================
           PRODUCT IMAGE
           ========================================= */

    .product-img {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 6px;
    }

    /* =========================================
           EMPTY CART
           ========================================= */

    .empty-message {
        text-align: center;
        color: #558b2f;
        font-weight: 600;
        padding: 40px 20px;
    }

    /* =========================================
           ORDER TOTAL
           ========================================= */

    .order-total {
        flex-shrink: 0;
        text-align: right;
        font-weight: 700;
        font-size: 1.15rem;
        color: #2e7d32;
        padding: 8px 5px 4px;
    }

    /* =========================================
           CART ACTIONS
           ========================================= */

    .cart-actions {
        flex-shrink: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
        gap: 10px;
    }

    .checkout-btn {
        background-color: #2e7d32;
        color: white;
        border: none;
        padding: 0.65rem 1.4rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
    }

        .checkout-btn:hover {
            background-color: #27632a;
        }

    .clear-btn {
        background-color: wheat;
        color: black;
        border: none;
        padding: 0.65rem 1.4rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
    }

        .clear-btn:hover {
            background-color: white;
        }

    /* =========================================
           QUANTITY CONTROLS
           ========================================= */

    .qty-control {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 5px;
        background-color: #a5d6a7;
        color: #1b5e20;
        font-weight: bold;
        cursor: pointer;
    }

        .qty-btn:hover {
            background-color: #81c784;
        }

    .qty-display {
        min-width: 35px;
        text-align: center;
        font-weight: 600;
    }

    /* =========================================
           DIVIDER
           ========================================= */

    hr {
        flex-shrink: 0;
        width: 100%;
        border: 0;
        border-top: 1px solid #c5e1a5;
        margin: 12px 0;
    }

    /* =========================================
           RECENT ORDERS TITLE
           ========================================= */

    h3 {
        flex-shrink: 0;
        color: #33691e;
        margin: 0 0 7px 0;
        font-weight: 700;
        font-size: 18px;
    }

    /* =========================================
           RECENT ORDERS WINDOW
           ========================================= */

    /*
         * Reduced from 165px to 150px.
         *
         * This gives the Shopping Cart window
         * slightly more vertical space.
         *
         * Recent Orders still shows approximately
         * 3 rows before scrolling.
         */

    .recent-orders-window {
        flex: 0 0 150px;
        height: 150px;
        min-height: 150px;
        border: 1px solid #c8e6c9;
        border-radius: 8px;
        background-color: white;
        overflow: hidden;
        box-sizing: border-box;
    }

    .recent-orders {
        width: 100%;
        height: 100%;
        overflow-y: auto;
        overflow-x: auto;
    }

        /* =========================================
           RECENT ORDERS TABLE
           ========================================= */

        .recent-orders table {
            width: 100%;
            min-width: 750px;
            border-collapse: collapse;
        }

        .recent-orders th,
        .recent-orders td {
            border: 1px solid #ddd;
            padding: 7px 8px;
            text-align: left;
            font-size: 13px;
            white-space: nowrap;
        }

        .recent-orders th {
            background-color: #a5d6a7;
            color: #1b5e20;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .recent-orders tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .recent-orders tr:hover {
            background-color: #f1f8f1;
        }

        /* =========================================
           RECENT ORDERS SCROLLBAR
           ========================================= */

        .recent-orders::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .recent-orders::-webkit-scrollbar-thumb {
            background: #a5d6a7;
            border-radius: 4px;
        }

            .recent-orders::-webkit-scrollbar-thumb:hover {
                background: #81c784;
            }

    /* =========================================
           STATUS BADGES
           ========================================= */

    .status-badge {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 12px;
        white-space: nowrap;
    }

    .status-Pending {
        background-color: #fff3cd;
        color: #7a5b00;
    }

    .status-Processing {
        background-color: #cfe2ff;
        color: #084298;
    }

    .status-Shipped {
        background-color: #e2d9f3;
        color: #4b2e83;
    }

    .status-Delivered {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .status-Cancelled {
        background-color: #f8d7da;
        color: #842029;
    }

    /* =========================================
           MOBILE
           ========================================= */

    @@media (max-width: 700px) {

        body {
            padding: 15px 0;
        }

        .cart-card {
            width: 95%;
            height: 94vh;
            padding: 18px 15px;
        }

        .cart-header {
            font-size: 21px;
        }

        .recent-orders-window {
            flex: 0 0 150px;
            height: 150px;
            min-height: 150px;
        }

        .cart-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .clear-btn,
        .checkout-btn {
            width: 100%;
        }

        .recent-orders th,
        .recent-orders td {
            padding: 6px;
            font-size: 12px;
        }
    }
</style>


<div class="cart-card">

    <!-- =====================================
         HEADER
         ===================================== -->

    <h2 class="cart-header">
        🛒 My Shopping Cart
    </h2>


    <a asp-page="/Landing" class="back-link">
        <i class="bi bi-arrow-left"></i>
        Continue Shopping
    </a>


    <!-- =====================================
         SHOPPING CART WINDOW
         ===================================== -->

    <div class="cart-window">

        @if (!Model.CartItems.Any())
        {
            <div class="empty-message">
                Your cart is empty.
            </div>
        }
        else
        {
            <div class="cart-table-container">

                <table class="cart-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Unit</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.CartItems)
                        {
                            <tr>

                                <td>

                                    <img src="@Url.Content(item.ImagePath ?? "~/images/placeholder.png")"
                                         alt="@item.ProductName"
                                         class="product-img" />

                                    <br />

                                    @item.ProductName

                                </td>

                                <td>
                                    @item.UnitOfMeasure
                                </td>

                                <td>

                                    <div class="qty-control">

                                        <form method="post"
                                              asp-page-handler="Decrease"
                                              asp-route-cartItemId="@item.Id"
                                              style="display:inline;">

                                            <button type="submit"
                                                    class="qty-btn">
                                                -
                                            </button>

                                        </form>

                                        <span class="qty-display">
                                            @item.Quantity
                                        </span>

                                        <form method="post"
                                              asp-page-handler="Increase"
                                              asp-route-cartItemId="@item.Id"
                                              style="display:inline;">

                                            <button type="submit"
                                                    class="qty-btn">
                                                +
                                            </button>

                                        </form>

                                    </div>

                                </td>

                                <td>
                                    ₱ @item.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    ₱ @((item.UnitPrice * item.Quantity).ToString("N2"))
                                </td>

                                <td>

                                    <form method="post"
                                          asp-page-handler="Remove"
                                          asp-route-cartItemId="@item.Id">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================
                 CART TOTAL
                 ================================= -->

            <div class="order-total">

                Total:

                ₱ @(Model.CartItems
                            .Sum(x => x.UnitPrice * x.Quantity)
                            .ToString("N2"))

        </div>


            <!-- =================================
                 CART BUTTONS
                 ================================= -->

            <div class="cart-actions">

                <form method="post"
                      asp-page-handler="Clear"
                      style="display:inline;">

                    <button type="submit"
                            class="clear-btn">
                        Clear Cart
                    </button>

                </form>


                <form method="post"
                      asp-page-handler="Checkout"
                      style="display:inline;">

                    <button type="submit"
                            class="checkout-btn">
                        Proceed Checkout
                    </button>

                </form>

            </div>
                }

    </div>


    <!-- =====================================
         RECENT ORDERS
         ===================================== -->
    @if (Model.RecentPaidOrders.Any())
    {
        <hr />

        <h3>
            🧾 Recent Orders
        </h3>


        <div class="recent-orders-window">

            <div class="recent-orders">

                <table>

                    <thead>
                        <tr>
                            <th>OR Number</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                            <th>Pay Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var order in Model.RecentPaidOrders)
                        {
                            foreach (var item in order.OrderItems)
                            {
                                <tr>

                                    <td>
                                        @order.ORNumber
                                    </td>

                                    <td>
                                        @item.Product?.Name
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        ₱ @item.UnitPrice.ToString("N2")
                                    </td>

                                    <td>
                                        ₱ @((item.Quantity * item.UnitPrice).ToString("N2"))
                                    </td>

                                    <td>
                                        @order.PayDate?.ToString("MMM dd, yyyy hh:mm tt")
                                    </td>

                                    <td>

                                        <span class="status-badge status-@order.Status">
                                            @order.Status
                                        </span>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>
